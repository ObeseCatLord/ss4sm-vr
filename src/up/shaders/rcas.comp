#version 450
// Sharpening of the upscaled image: AMD FidelityFX RCAS (robust contrast-adaptive sharpening, FSR 1 / FSR 3.1's own
// sharpener, MIT), with its noise removal, on the HDR scene colour. RCAS assumes values in [0, 1], so each tap goes
// through the reversible tonemap c / (1 + max(c)) and the result back through its inverse.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba16f) uniform readonly image2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform PC {
    vec4 p;  // sharpness 0..1 (RCAS con: 1 = its maximum), width, height, unused
} pc;

const float kLimit = 0.25 - 1.0 / 16.0;  // FSR_RCAS_LIMIT

vec3 tap(ivec2 q) {
    q = clamp(q, ivec2(0), ivec2(pc.p.yz) - 1);
    vec3 c = max(imageLoad(src, q).rgb, vec3(0.0));
    return c / (1.0 + max(c.r, max(c.g, c.b)));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.p.y) || p.y >= int(pc.p.z)) return;
    //    b
    //  d e f
    //    h
    vec3 b = tap(p + ivec2(0, -1)), d = tap(p + ivec2(-1, 0)), e = tap(p), f = tap(p + ivec2(1, 0)), h = tap(p + ivec2(0, 1));
    vec3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));
    vec3 hitMin = min(mn4, e) / (4.0 * mx4 + 1e-6);
    vec3 hitMax = (1.0 - max(mx4, e)) / (4.0 * mn4 - 4.0 - 1e-6);
    vec3 lobeRGB = max(-hitMin, hitMax);
    float lobe = max(-kLimit, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * pc.p.x;
    // Noise removal: less sharpening where the centre stands out of a flat neighbourhood (grain, sparkles).
    float bL = b.b * 0.5 + (b.r * 0.5 + b.g), dL = d.b * 0.5 + (d.r * 0.5 + d.g), eL = e.b * 0.5 + (e.r * 0.5 + e.g),
          fL = f.b * 0.5 + (f.r * 0.5 + f.g), hL = h.b * 0.5 + (h.r * 0.5 + h.g);
    float nz = 0.25 * (bL + dL + fL + hL) - eL;
    float range = max(max(max(bL, dL), max(eL, fL)), hL) - min(min(min(bL, dL), min(eL, fL)), hL);
    nz = clamp(abs(nz) / max(range, 1e-6), 0.0, 1.0);
    lobe *= -0.5 * nz + 1.0;
    vec3 s = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
    s = clamp(s, vec3(0.0), vec3(0.999));
    vec3 c = s / (1.0 - max(s.r, max(s.g, s.b)));
    imageStore(dst, p, vec4(c, imageLoad(src, p).a));
}
